[gd_resource type="Resource" script_class="GameEvents" format=3 uid="uid://blb71cw7hx5ap"]

[ext_resource type="Script" uid="uid://dji1gvea14ls8" path="res://alice/turn_mgr/events/turn_event.gd" id="1_pmwtw"]
[ext_resource type="Script" uid="uid://drfbg3jb0nf5x" path="res://alice/turn_mgr/events/game_events.gd" id="2_j6330"]

[sub_resource type="Resource" id="Resource_0lpg8"]
script = ExtResource("1_pmwtw")
target_town = 9
type = 1
text = "Un message de l'ouest. Des hommes en armes sont venus, et on pris la ville de Solafa. Ils en ont fais une forteresse, et interdit a tout navire d'y entrer. Il sera beaucoup plus risque de faire du commerce la-bas.."
threat_increase = 25
metadata/_custom_type_script = "uid://dji1gvea14ls8"

[sub_resource type="Resource" id="Resource_f100b"]
script = ExtResource("1_pmwtw")
target_town = 0
type = 2
text = "La flotte portugaise est a nos portes ! Apres une terrible bataille, notre ville est prise, et des lois sont instaurees, imposant que chaque bateau soit escorte. Et leurs gardes ne sont pas gratuits"
increase_min_guards = 4
metadata/_custom_type_script = "uid://dji1gvea14ls8"

[sub_resource type="Resource" id="Resource_ephac"]
script = ExtResource("1_pmwtw")
target_town = 0
text = "Nos voisins de Goa sont encore libres, et nous aideront a commercer sur ces mer. Nous pouvons encore compter sur des amis !"
threat_increase = -5
metadata/_custom_type_script = "uid://dji1gvea14ls8"

[sub_resource type="Resource" id="Resource_byyj6"]
script = ExtResource("1_pmwtw")
target_town = 0
type = 1
text = "Les forteresses portugaises se multiplients, de nombreux ports sont dorenavant difficiles d'acces sans protection, et beaucoup de navires ne reviennent jamais"
threat_increase = 15
metadata/_custom_type_script = "uid://dji1gvea14ls8"

[sub_resource type="Resource" id="Resource_pmwtw"]
script = ExtResource("1_pmwtw")
target_town = 7
type = 1
text = "Un message de l'ouest. Les hommes qui ont pris Sofalla il y a quelques annees disent venir du royaume du Portugal. Ils comptent s'installer dans tous les ports environnants, et faire leurs forteresses.. Le dernier port attaque est celui d'Ormuz. On dis que nul ne peut plus approcher du passage d'Ormuz.."
threat_increase = 30
metadata/_custom_type_script = "uid://dji1gvea14ls8"

[sub_resource type="Resource" id="Resource_p65io"]
script = ExtResource("1_pmwtw")
target_town = 0
type = 1
text = "Les annees se font longues depuis que les portugais bloquent le commerce. D'autres ports tombent sous leur joug, et ils interdisent le commerce de nombreux bien. Nous devons etre prudents"
threat_increase = 25
metadata/_custom_type_script = "uid://dji1gvea14ls8"

[sub_resource type="Resource" id="Resource_j6330"]
script = ExtResource("1_pmwtw")
target_town = 0
type = 3
text = "En quelques annees, ces hommes venus de loin se sont empares de tout le commerce de cet ocean. Il n'est pratiquement plus possible que de commercer avec eux. Aujourd'hui, c'est au tour de nos voisins de Goa de tomber sous leur joug.. Nous sommes seuls"
metadata/_custom_type_script = "uid://dji1gvea14ls8"

